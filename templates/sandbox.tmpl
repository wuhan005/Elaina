<!doctype html>
<html lang="{{ .Lang }}">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{{ .Sandbox.Name }} - Elaina</title>
  <link rel="icon" type="image/png" href="/favicon.png"/>
  <link rel="stylesheet" href="{{ .CodeMirror.CSS }}"/>
  <link rel="stylesheet" href="/static/css/sandbox.css"/>
  <script>
    // Pick the theme before the first paint: ?theme=light|dark, otherwise the system preference.
    (function () {
      var theme = new URLSearchParams(location.search).get('theme');
      if (theme !== 'light' && theme !== 'dark') {
        theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.dataset.theme = theme;
    })();
  </script>
</head>
<body>
<div class="app">
  <header class="toolbar">
    <div class="brand">
      <img src="/logo.png" alt="" class="logo" width="28" height="28"/>
      <h1 class="title" title="{{ .Sandbox.Name }}">{{ .Sandbox.Name }}</h1>
      {{ if not .Editable }}<span class="badge">{{ .Text.read_only }}</span>{{ end }}
    </div>

    <div class="actions">
      {{ if gt (len .LanguageOptions) 1 }}
      <div class="segmented" role="radiogroup" aria-label="{{ .Text.language }}">
        {{ range .LanguageOptions }}
        <button type="button" role="radio" class="segment" data-lang="{{ .Value }}"
                aria-checked="{{ if eq .Value $.Language }}true{{ else }}false{{ end }}">{{ .Label }}</button>
        {{ end }}
      </div>
      {{ else }}
      {{ range .LanguageOptions }}<span class="badge badge-language">{{ .Label }}</span>{{ end }}
      {{ end }}

      <form method="post" target="_blank" id="new-window" hidden>
        <input type="hidden" name="c" id="post-code"/>
        <button type="submit" class="btn btn-secondary" title="{{ .Text.open_in_new_window }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6v2H5v11h11v-5h2v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6Zm11-3v8h-2V6.41l-7.79 7.8-1.42-1.42L17.59 5H13V3h8Z"/></svg>
          <span class="btn-label">{{ .Text.open_in_new_window }}</span>
        </button>
      </form>

      <button type="button" class="btn btn-primary" id="run">
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11-6.86a1 1 0 0 0 0-1.7l-11-6.86A1 1 0 0 0 8 5.14Z"/></svg>
        <span class="spinner" aria-hidden="true"></span>
        <span id="run-label">{{ .Text.run }}</span>
        <kbd id="run-shortcut"></kbd>
      </button>
    </div>
  </header>

  <main class="workspace" id="workspace">
    <section class="editor-pane">
      <textarea id="code">{{ .Code }}</textarea>
    </section>

    <div class="splitter" id="splitter" role="separator" aria-orientation="horizontal"
         aria-label="{{ .Text.resize }}" aria-valuemin="20" aria-valuemax="85" aria-valuenow="60"
         tabindex="0"></div>

    <section class="output-pane" aria-live="polite">
      <div class="output-header">
        <span class="output-title">{{ .Text.output }}</span>
        <span class="status" id="status" hidden></span>
        <span class="duration" id="duration"></span>
        <button type="button" class="btn-link" id="clear" hidden>{{ .Text.clear }}</button>
      </div>
      <div class="output-body" id="output">
        <p class="placeholder">{{ .Text.idle }}</p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <a href="https://github.com/wuhan005/Elaina" target="_blank" rel="noreferrer">{{ .Text.powered_by }}</a>
  </footer>
</div>

{{ range .CodeMirror.Scripts }}
<script src="{{ . }}"></script>
{{ end }}
<script>window.ELAINA = {{ .Config }};</script>
<script src="/static/js/sandbox.js"></script>
</body>
</html>
